{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "functions": {
    "artifacts/awdp-site/api/**/*.js": {
      "runtime": "nodejs20.x",
      "includeFiles": [
        "artifacts/api-server/dist/**",
        "artifacts/awdp-site/vercel-serverless-bridge.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
