{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node vercel-install.cjs",
  "buildCommand": "node vercel-build.cjs",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "rewrites": [
    { "source": "/api", "destination": "/api/catalog-proxy" },
    { "source": "/api/:path*", "destination": "/api/catalog-proxy?__awdp_path=:path*" },
    { "source": "/sitemap.xml", "destination": "/api/catalog-proxy?__awdp_root=sitemap.xml" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/resources/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
