{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node vercel-install.cjs",
  "buildCommand": "node vercel-build.cjs",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "redirects": [
    {
      "source": "/assets/header_bg.jpg",
      "destination": "/assets/header_bg.png?v=approved-20260629-2",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/proxy" },
    { "source": "/api/:path*", "destination": "/api/proxy?__awdp_path=:path*" },
    { "source": "/sitemap.xml", "destination": "/api/proxy?__awdp_root=sitemap.xml" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/header_bg.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/header_bg.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/resources/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
