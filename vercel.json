{
    "installCommand": "npm i -g pnpm && pnpm install --no-frozen-lockfile",
+    "buildCommand": "cd artifacts/api-server && node build.mjs && npx esbuild src/index.ts --outfile=dist/serverless.cjs --bundle --platform=node --format=cjs && cd ../awdp-site && npx vite build",
    "outputDirectory": "artifacts/awdp-site/dist/public",
    "functions": {
          "api/server.js": {
                  "includeFiles": "artifacts/api-server/dist/**",
                  "maxDuration": 10
          }
    },
    "rewrites": [
          { "source": "/api/(.*)", "destination": "/api/server" },
          { "source": "/(.*)", "destination": "/index.html" }
    ]
}
