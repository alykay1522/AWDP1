{
  "version": 2,
  "installCommand": "node vercel-install.cjs",
  "buildCommand": "pnpm build",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
