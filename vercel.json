{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "node vercel-install.cjs",
  "buildCommand": "pnpm build",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "functions": {
    "artifacts/awdp-site/api/**/*.{js,mjs}": {
      "maxDuration": 60,
      "includeFiles": "artifacts/{api-server/dist/**,awdp-site/vercel-serverless-bridge.js}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
