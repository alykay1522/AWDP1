{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node vercel-install.cjs",
  "buildCommand": "node vercel-build.cjs",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "allwindowdoorparts.com"
        }
      ],
      "destination": "https://www.allwindowdoorparts.com/:path*",
      "permanent": true
    },
    {
      "source": "/assets/header_bg.jpg",
      "destination": "/assets/header_bg.png?v=approved-20260629-2",
      "permanent": false
    },
    {
      "source": "/privacy-policy",
      "destination": "/policies#privacy",
      "permanent": true
    },
    {
      "source": "/categories/:slug",
      "destination": "/categories",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wp-content/uploads/:year/:month/:filename",
      "destination": "/api/proxy?__awdp_path=legacy-pdf/:year/:month/:filename"
    },
    {
      "source": "/api",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__awdp_path=:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/proxy?__awdp_root=sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/api/ssr?path=/"
    },
    {
      "source": "/shop",
      "destination": "/api/ssr?path=/shop"
    },
    {
      "source": "/categories",
      "destination": "/api/ssr?path=/categories"
    },
    {
      "source": "/parts-identification",
      "destination": "/api/ssr?path=/parts-identification"
    },
    {
      "source": "/identify-balance",
      "destination": "/api/ssr?path=/identify-balance"
    },
    {
      "source": "/guides",
      "destination": "/api/ssr?path=/guides"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/ssr?path=/guides/:slug"
    },
    {
      "source": "/product/:sku",
      "destination": "/api/ssr?path=/product/:sku"
    },
    {
      "source": "/resources",
      "destination": "/api/ssr?path=/resources"
    },
    {
      "source": "/about",
      "destination": "/api/ssr?path=/about"
    },
    {
      "source": "/contact",
      "destination": "/api/ssr?path=/contact"
    },
    {
      "source": "/policies",
      "destination": "/api/ssr?path=/policies"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://*.paypal.com\")"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.paypal.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.paypal.com https://*.paypalobjects.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://analytics.google.com https://www.google.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://*.paypal.com https://va.vercel-scripts.com https://vitals.vercel-insights.com https://blob.vercel-storage.com https://*.blob.vercel-storage.com; frame-src https://*.paypal.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/header_bg.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/header_bg.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/resources/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "artifacts/awdp-site/dist/public/**"
    }
  }
}
