{
  "installCommand": "node vercel-install.cjs",
  "buildCommand": "pnpm --filter @workspace/api-server run build && cd artifacts/awdp-site && pnpm exec vite build",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60,
      "includeFiles": "{artifacts/api-server/dist/**,artifacts/awdp-site/vercel-serverless-bridge.js}"
    },
    "api/**/*.mjs": {
      "runtime": "nodejs20.x",
      "maxDuration": 60,
      "includeFiles": "{artifacts/api-server/dist/**,artifacts/awdp-site/vercel-serverless-bridge.js}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/((?!api(?:/|$)|_next|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/resources/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
