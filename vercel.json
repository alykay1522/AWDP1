{
  "framework": null,
  "installCommand": "corepack enable && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd artifacts/awdp-site && pnpm exec vite build",
  "outputDirectory": "artifacts/awdp-site/dist/public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
