{
  "name": "awdp",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.0",
    "vercel": "^54.4.1"
  },
  "scripts": {
    "dev": "pnpm --filter awdp-site run dev",
    "build": "pnpm --filter @workspace/api-server run build && pnpm --filter awdp-site run build",
    "preview": "pnpm --filter awdp-site run serve",
    "vercel:set-api": "node scripts/vercel-set-api-origin.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "esbuild": "0.25.8"
    }
  }
}
