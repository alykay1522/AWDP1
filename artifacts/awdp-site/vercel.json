{
  "framework": null,
  "installCommand": "cd ../.. && node vercel-install.cjs",
  "buildCommand": "cd ../.. && node vercel-build.cjs",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
